# VoiceShield Environment Configuration
# Note: If no API keys are provided, VoiceShield automatically runs in
# Offline Heuristic Engine mode with 100% full feature parity!

# Server Settings
HOST=127.0.0.1
PORT=8000

# Optional: OpenAI API Key (gpt-4o-mini / gpt-4o)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Google Gemini API Key (gemini-1.5-flash / gemini-2.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# SQLite Database File Location (Defaults to backend/voiceshield.db)
# DATABASE_PATH=backend/voiceshield.db
